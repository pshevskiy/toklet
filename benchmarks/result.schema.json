  "required": [
    "schema_version",
    "contract_id",
    "comparison_track",
    "runtime",
    "identity",
    "representation",
    "workload",
    "timing_scope",
    "setup",
    "samples",
    "summary",
    "memory",
    "energy",
    "notes"
