      "additionalProperties": false,
      "properties": {
        "completion_boundary": {
          "type": "string"
        },
        "first_visible_text_policy": {
          "type": "string"
        },
        "includes_detokenization": {
          "type": "boolean"
        },
        "includes_sampling": {
          "type": "boolean"
        },
        "includes_tokenization": {
          "type": "boolean"
        }
      },
      "required": [
        "includes_tokenization",
        "includes_sampling",
        "includes_detokenization",
        "completion_boundary",
        "first_visible_text_policy"
      ],
      "type": "object"
    },
    "workload": {
      "additionalProperties": false,
      "properties": {
        "cache_state": {
          "enum": [
            "empty",
            "exact_prefix_append",
            "fully_cached",
            "pending_sample",
            "changed_prefix_replay"
          ]
        },
        "context_capacity": {
          "minimum": 1,
          "type": "integer"
        },
        "continuation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "output_steps": {
          "minimum": 1,
          "type": "integer"
        },
        "prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "prompt_tokens": {
          "minimum": 1,
          "type": "integer"
        },
        "stop_policy": {
          "type": "string"
        },
        "used_context_before_request": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "prompt_tokens",
        "output_steps",
        "context_capacity",
        "used_context_before_request",
        "prompt_sha256",
        "continuation_sha256",
        "stop_policy",
        "cache_state"
      ],
      "type": "object"
    }
